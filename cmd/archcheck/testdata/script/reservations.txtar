  - id: app
    name: App
    technology: Go
    description: The application.
layers:
  - id: core
    directory: internal/core
    description: The core.
    uses: []
    external: []
components: []
test_modules: []
rules: []
-- architecture/designs/0001-start.md --
---
design: 1
issue: 1
title: Start
---
-- architecture/designs/0002-layers.md --
---
design: 2
issue: 2
title: Layers
---
-- missing.txt --
refs/tags/design/0001	tag	issue: 1
refs/tags/design/0002	commit	issue: 2
-- other.txt --
refs/tags/design/0001	tag	issue: 9
refs/tags/design/0002	tag	issue: 2
-- good.txt --
refs/tags/design/0001	tag	issue: 1
refs/tags/design/0002	tag	issue: 2
-- bad.txt --
refs/tags/design/0001 tag issue: 1
