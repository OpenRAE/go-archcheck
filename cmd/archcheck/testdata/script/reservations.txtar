# Without -reservations, the record checks do not change.
exec archcheck -code=false
stdout '^archcheck: no findings$'

# With -reservations, a record without an annotated reservation tag is a finding.
exitcode 1 archcheck -code=false -reservations missing.txt
stderr '^architecture/designs/0002-layers.md: design-record: design number 2 has no reservation tag design/0002$'
stderr '^archcheck: 1 finding$'

# A record whose issue differs from the issue of its tag is a finding.
exitcode 1 archcheck -code=false -reservations other.txt
stderr '^architecture/designs/0001-start.md: design-record: the reservation tag design/0001 names issue 9, but the front matter states issue 1$'
stderr '^archcheck: 1 finding$'

# A tag for each record with the issue of the record meets the rule.
exec archcheck -code=false -reservations good.txt
stdout '^archcheck: no findings$'

# A malformed file is an error.
exitcode 1 archcheck -code=false -reservations bad.txt
stderr '^archcheck: bad.txt: line 1: want the reference name, the object type and the subject, separated by tabs$'

# A reserve usage error prints the usage of reserve and fails.
exitcode 2 archcheck reserve -issue 1
stderr '^usage: archcheck reserve -repo owner/name -issue N \[-designs dir\]$'

-- go.mod --
module example.com/m

go 1.27
-- architecture/model.yaml --
version: 1
